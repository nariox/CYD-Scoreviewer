CONFIG_LV_CONF_SKIP=y
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_XPT2046_INTERRUPT_MODE=y
CONFIG_XPT2046_CONVERT_ADC_TO_COORDS=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# Unused LVGL widgets — disabled to save flash
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARCLABEL is not set
CONFIG_LV_USE_BAR=y
# CONFIG_LV_USE_BTNMATRIX is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CALENDAR_HEADER_ARROW is not set
# CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN is not set
# CONFIG_LV_USE_CANVAS is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LINE is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
CONFIG_LV_USE_SPINNER=y
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
CONFIG_LV_USE_THEME_DEFAULT=y
# CONFIG_LV_USE_THEME_SIMPLE is not set
# CONFIG_LV_BUILD_EXAMPLES is not set

# Perf: LVGL benefits hugely from -O2 and 240MHz CPU; LCD SPI already at 40MHz
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# LVGL 9.5 IRAM_ATTR conflicts fail -Werror; leave off

# balldontlie.io uses a GTS cert served cross-signed (by GlobalSign); this
# option lets the esp_crt_bundle validate such chains against GTS roots.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# NOTE: tried SSL_IN_CONTENT_LEN=4096 to claw ~12 KB of heap per HTTPS
# connection - deterministically broke the handshake (-0x0087): ESP's mbedTLS
# does not negotiate MaxFragmentLength, so the IN buffer must absorb whatever
# record the server sends (ESPN's CDN cert chain records exceed 4 KB). Keep
# the default 16 KB IN; OUT=4096 is safe (we never send large records).
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
