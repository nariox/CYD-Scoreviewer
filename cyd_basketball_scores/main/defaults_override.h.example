/* defaults_override.h — compile-time default overrides
 *
 * Copy this file to defaults_override.h and uncomment the lines you need.
 * The CMakeLists.txt will detect it and include it at build time.
 *
 * These values are used as defaults when NVS is empty, corrupt, or has a
 * schema version mismatch. They do NOT override values already saved in NVS.
 *
 * This file is included AFTER nvs_settings.h, so it can #undef and #define
 * the NVS_DEFAULT_* macros to override them.
 */

