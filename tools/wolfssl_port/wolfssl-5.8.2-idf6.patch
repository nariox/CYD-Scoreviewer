+/* ===== wolfssl-spike DIET profile (capture 14 experiment) =====
+ * Compile the ESPN client's minimum: TLS 1.2/1.3 client, ECDHE over X25519
+ * with RSA server auth, AES-256-GCM (SHA384), X509 verify via SHA-256/384
+ * up through an RSA-4096 root, SNI + TLSX. Wi-Fi crypto is mbedTLS's job
+ * (wpa_supplicant), NOT wolfSSL's - trimming here cannot break WPA2.
+ * The stock settings' ECC/ED25519/SHA512 come from the MY_USE_ECC menu
+ * above; undef'ing at EOF wins. NO_ECC is the big one: X25519 pin means
+ * wolfCrypt's NIST curve code never runs in a handshake anyway. */
+#undef  HAVE_ED25519
+#define NO_ED25519
+#undef  WOLFSSL_SHA512      /* SHA-384 stands alone in sha512.c */
+/* NO_ECC NOT possible: internal.c ~32632 uses peerEccKey unguarded when
+ * TLS 1.2 named-curve handling is compiled (HAVE_CURVE25519 on) - upstream
+ * gap, patch candidate for Gate 2. */
+#define NO_WOLFSSL_SERVER
+#define NO_MD5
+#define NO_DSA
+#define NO_SHA              /* chain is SHA-256/384; TLS1.2 suite is AEAD */
+#define NO_ERROR_STRINGS    /* costs ~20 KB text; spike logs numeric codes */
+#define WOLFSSL_SMALL_STACK /* capture 15: big locals -> pool, shrinks task-stack need */
+/* SP math REJECTED (capture 16i): +22 KB flash, handshakes ~20% slower
+ * (300-304 ms vs 247-254 TLS1.3), sp_int(4096) ~= fp_int size so no pool
+ * win either - the sp_c32 kernels are tuned for 64-bit/asm platforms.
+ * NOTE the landmine found on the way: SP_MATH_ALL without
+ * WOLFSSL_HAVE_SP_RSA derives SP_INT_BITS=3072 and the 4096-bit root
+ * verify dies MEMORY_E in mp_init_size (rsa.c INIT_MP_INT_SIZE). */
